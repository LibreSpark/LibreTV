FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LOG_LEVEL=INFO

WORKDIR /service

RUN groupadd --gid 10001 libretv \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin libretv \
    && mkdir -p /service/app \
    && chown -R 10001:10001 /service

COPY app/egress_proxy.py app/site_governor.py /service/app/

USER 10001:10001
EXPOSE 8080
CMD ["python", "-m", "app.egress_proxy"]
