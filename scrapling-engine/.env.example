# Bind to loopback for local development. Do not expose publicly without auth.
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=25
MAX_RESPONSE_BYTES=5242880
DEFAULT_USER_AGENT=LibreTV-Scrapling-Engine/0.1 (+respectful public resource discovery)

# Optional: use PostgreSQL for durable crawl jobs, results, and audit events.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scrapling

# Optional OpenAI-compatible AI Supervisor planner.
# The planner can only choose bounded same-origin discovery limits; it cannot run code.
# SUPERVISOR_API_BASE=https://api.openai.com/v1
# SUPERVISOR_API_KEY=replace-with-provider-api-key
# SUPERVISOR_MODEL=gpt-4.1-mini
# SUPERVISOR_TIMEOUT_SECONDS=45
